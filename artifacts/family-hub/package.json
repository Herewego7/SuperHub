{
  "name": "@workspace/family-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts && node scripts/postbuild-web.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:mobile": "BASE_PATH=/ PORT=5173 vite build --config vite.config.ts",
    "cap:add:ios": "cap add ios",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "ios": "pnpm run build:mobile && pnpm run cap:sync && pnpm run cap:open:ios",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 tests/e2e/**/*.test.ts",
    "test:layout": "tsx --test tests/e2e/layout.test.ts"
  },
