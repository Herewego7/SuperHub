# Backend origin baked into production builds.
#
# Required by the native (Capacitor/iOS) app: the webview runs at
# capacitor://localhost, so API requests and the OAuth login flow must be
# pointed at the real backend origin (see src/lib/apiBase.ts and
# src/lib/nativeAuth.ts). Vite inlines VITE_* vars at build time.
#
# Harmless on the web build: apiBase.ts only uses this value when
# Capacitor.isNativePlatform() is true, so web keeps using same-origin
# relative paths.
VITE_API_BASE_URL=https://super-hub.replit.app
