{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Express handlers end some branches with `return res.json(...)` and
    // others without a return; the value is never used. 140 such errors
    // kept typecheck, and so `pnpm build`, failing (2026-10-21).
    "noImplicitReturns": false
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    }
  ]
}
