{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "scan-inbox": "node --enable-source-maps ./dist/inboxScanJob.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:node": "DATABASE_URL=\"${DATABASE_URL:-postgres://test:test@localhost:5432/testdb}\" tsx --test tests/*.test.ts",
    "test:scripts": "DATABASE_URL=\"${DATABASE_URL:-postgres://test:test@localhost:5432/testdb}\" tsx src/calendarSyncPlan.test.ts && DATABASE_URL=\"${DATABASE_URL:-postgres://test:test@localhost:5432/testdb}\" tsx src/lib/apns.test.ts && DATABASE_URL=\"${DATABASE_URL:-postgres://test:test@localhost:5432/testdb}\" tsx src/replit_integrations/auth/rateLimit.test.ts && DATABASE_URL=\"${DATABASE_URL:-postgres://test:test@localhost:5432/testdb}\" tsx src/replit_integrations/auth/resetToken.test.ts && DATABASE_URL=\"${DATABASE_URL:-postgres://test:test@localhost:5432/testdb}\" tsx src/replit_integrations/auth/password.test.ts",
    "test": "pnpm run test:node && pnpm run test:scripts",
    "test:api": "tsx --test --test-force-exit tests/api/**/*.test.ts",
    "test:api:db": "./scripts/with-test-db.sh pnpm run test:api"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.51.0",
    "@replit/object-storage": "^1.0.0",
    "@sentry/node": "^10.70.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "axios": "^1.15.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "ical.js": "^2.2.1",
    "ipaddr.js": "^2.3.0",
    "jose": "^6.2.3",
    "memoizee": "^0.4.17",
    "multer": "^2.1.1",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "pino": "^9",
    "pino-http": "^10",
    "undici": "^8.1.0",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/memoizee": "^0.4.12",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/passport": "^1.0.17",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "^4.21.0"
  }
}
